<Window x:Class="ColorPickerWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ColorPickerWPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Rectangle x:Name="ColorPreview" HorizontalAlignment="Left" Height="292" Margin="59,67,0,0" Stroke="Black" VerticalAlignment="Top" Width="253"/>
        <Slider x:Name="SLR" HorizontalAlignment="Left" Margin="524,165,0,0" VerticalAlignment="Top" Width="120" ValueChanged="SLB_ValueChanged"/>
        <Slider x:Name="SLG" HorizontalAlignment="Left" Margin="524,200,0,0" VerticalAlignment="Top" Width="120" ValueChanged="SLB_ValueChanged"/>
        <Slider x:Name="SLB" HorizontalAlignment="Left" Margin="524,235,0,0" VerticalAlignment="Top" Width="120" ValueChanged="SLB_ValueChanged"/>
        <Label x:Name="BarvaR" Content="Red:" HorizontalAlignment="Left" Margin="443,165,0,0" VerticalAlignment="Top"/>
        <Label x:Name="BarvaG" Content="Green:" HorizontalAlignment="Left" Margin="443,200,0,0" VerticalAlignment="Top"/>
        <Label x:Name="BarvaB" Content="Blue:" HorizontalAlignment="Left" Margin="443,235,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="T1" HorizontalAlignment="Left" Margin="374,165,0,0" TextWrapping="Wrap" Text="0" VerticalAlignment="Top" Width="64" TextChanged="T1_TextChanged"/>
        <TextBox x:Name="T2" HorizontalAlignment="Left" Margin="374,200,0,0" TextWrapping="Wrap" Text="0" VerticalAlignment="Top" Width="64" TextChanged="T1_TextChanged"/>
        <TextBox x:Name="T3" HorizontalAlignment="Left" Margin="374,235,0,0" TextWrapping="Wrap" Text="0" VerticalAlignment="Top" Width="64" TextChanged="T1_TextChanged"/>
        <Label x:Name="Hex" Content="#000000" HorizontalAlignment="Left" Height="55" Margin="406,304,0,0" VerticalAlignment="Top" Width="144"/>



    </Grid>
</Window>
